<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Gouge</AssemblyName>
        <RootNamespace>Gouge</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>fkerimk</Authors>
        <Product>Gouge</Product>
        <PackageProjectUrl>https://github.com/fkerimk/Sickle-Mapper</PackageProjectUrl>
        <RepositoryUrl>git@github.com:fkerimk/Sickle-Mapper.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Raylib-cs" Version="7.0.2"/>
        <PackageReference Include="rlImgui-cs" Version="3.2.0"/>
        <PackageReference Include="NetTopologySuite" Version="2.6.0"/>
        <PackageReference Include="LibTessDotNet" Version="1.1.15"/>
        <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2"/>
    </ItemGroup>

</Project>
